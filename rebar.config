{erl_opts, [warnings_as_errors, debug_info]}.

{deps, [
    {lfe, "~> 2.2"},
    {erlexec, "~> 2.3"}
]}.

{project_plugins, [
    {rebar3_lfe, "~> 0.5"}
]}.

{provider_hooks, [
    {pre, [{compile, {lfe, compile}}]}
]}.

{pre_hooks, [
    {"(linux|darwin|solaris|freebsd|netbsd|openbsd)", ct,
     "$REBAR_DEPS_DIR/lfe/bin/lfescript $REBAR_DEPS_DIR/lfe/bin/lfec "
     "-o $REBAR_BUILD_DIR/lib/wolong/test test/*_SUITE.lfe"}
]}.

{profiles, [
    {test, [
        {deps, [
            {ltest, "~> 0.13"}
        ]},
        {erl_opts, [{src_dirs, ["src", "test"]}]}
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling]},
    {plt_extra_apps, [erlexec]}
]}.
