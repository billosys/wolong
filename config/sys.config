%% Example sys.config for wolong.
%%
%% binaries: map of component (atom) -> absolute path to the pandaPI
%% executable. No defaults are invented for these paths -- every entry
%% below must be supplied explicitly (arc01 OQ3's recorded default: app
%% env only for 0.1.0; explicit beats convenient). Dev machines can get
%% these binaries via chengdu v0.1.0's install path -- see README.
%%
%% gate-timeouts: map of gate (atom) -> timeout in milliseconds. Not yet
%% enforced in arc01 (slice02's wolong_exec owns timeout/kill semantics);
%% the shape is validated here so config surface and enforcement land
%% independently.
%%
%% workdir: base-dir (absolute path used as the working directory for
%% supervised OS processes) and keep-artifacts (whether to retain
%% per-dispatch scratch directories after a run, for debugging).

[
 {wolong, [
    {binaries, #{
        parser => "/usr/local/bin/pandaPIparser",
        grounder => "/usr/local/bin/pandaPIgrounder",
        engine => "/usr/local/bin/pandaPIengine"
    }},
    {'gate-timeouts', #{
        parse => 5000,
        ground => 30000,
        solve => 60000,
        convert => 5000,
        verify => 5000
    }},
    {workdir, #{
        'base-dir' => "/tmp/wolong",
        'keep-artifacts' => false
    }}
 ]}
].
